---
import Layout from '../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';

const events = await getCollection('events');

const now = new Date();

const upcoming = events
	.filter((entry) => entry.data.date >= now)
	.sort((a, b) => a.data.date.valueOf() - b.data.date.valueOf());

const past = events
	.filter((entry) => entry.data.date < now)
	.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const dateFormatter = new Intl.DateTimeFormat('de-DE', {
	weekday: 'long',
	day: 'numeric',
	month: 'long',
	year: 'numeric',
});

const upcomingRendered = await Promise.all(
	upcoming.map(async (entry) => ({ entry, Content: (await render(entry)).Content })),
);
const pastRendered = await Promise.all(
	past.map(async (entry) => ({ entry, Content: (await render(entry)).Content })),
);
---

<Layout
	title="Auftritte"
	description="Kommende und vergangene Auftritte der Kirchheim Harmonists."
>
	<section class="page-intro">
		<div class="container">
			<p class="eyebrow">Termine</p>
			<h1>Auftritte</h1>
		</div>
	</section>

	<section class="events-section">
		<div class="container">
			<h2>Kommende Auftritte</h2>
			{
				upcomingRendered.length > 0 ? (
					<ol class="event-list">
						{upcomingRendered.map(({ entry, Content }) => (
							<li>
								<article class="event-card">
									<p class="event-card__date">
										<time datetime={entry.data.date.toISOString().slice(0, 10)}>
											{dateFormatter.format(entry.data.date)}
										</time>
									</p>
									<h3 class="event-card__title">{entry.data.title}</h3>
									<p class="event-card__venue">
										{entry.data.venue}, {entry.data.city}
									</p>
									<p class="event-card__meta">
										{entry.data.receptionTime && (
											<>Sektempfang {entry.data.receptionTime} Uhr &middot; </>
										)}
										Konzertbeginn {entry.data.startTime} Uhr
									</p>
									{entry.data.ensembles.length > 0 && (
										<div class="event-card__ensembles">
											<p class="event-card__ensembles-label eyebrow">Mitwirkende</p>
											<ul class="ensemble-list">
												{entry.data.ensembles.map((ensemble) => (
													<li>
														{ensemble.logo ? (
															<figure class="ensemble">
																<img
																	src={ensemble.logo}
																	alt=""
																	class="ensemble__logo"
																/>
																<figcaption class="ensemble__name">{ensemble.name}</figcaption>
															</figure>
														) : (
															<span class="ensemble-chip">{ensemble.name}</span>
														)}
													</li>
												))}
											</ul>
										</div>
									)}
									<p class="event-card__admission">{entry.data.admission}</p>
									<div class="event-card__note">
										<Content />
									</div>
								</article>
							</li>
						))}
					</ol>
				) : (
					<p class="no-events">
						Aktuell sind keine Termine geplant &ndash; neue Auftritte folgen in Kürze.
					</p>
				)
			}
		</div>
	</section>

	<section class="events-section events-section--past">
		<div class="container">
			<h2>Vergangene Auftritte</h2>
			{
				pastRendered.length > 0 ? (
					<ol class="event-list event-list--past">
						{pastRendered.map(({ entry, Content }) => (
							<li>
								<article class="event-card event-card--past">
									<p class="event-card__date">
										<time datetime={entry.data.date.toISOString().slice(0, 10)}>
											{dateFormatter.format(entry.data.date)}
										</time>
									</p>
									<h3 class="event-card__title">{entry.data.title}</h3>
									<p class="event-card__venue">
										{entry.data.venue}, {entry.data.city}
									</p>
									<p class="event-card__meta">
										{entry.data.receptionTime && (
											<>Sektempfang {entry.data.receptionTime} Uhr &middot; </>
										)}
										Konzertbeginn {entry.data.startTime} Uhr
									</p>
									{entry.data.ensembles.length > 0 && (
										<div class="event-card__ensembles">
											<p class="event-card__ensembles-label eyebrow">Mitwirkende</p>
											<ul class="ensemble-list">
												{entry.data.ensembles.map((ensemble) => (
													<li>
														{ensemble.logo ? (
															<figure class="ensemble">
																<img
																	src={ensemble.logo}
																	alt=""
																	class="ensemble__logo"
																/>
																<figcaption class="ensemble__name">{ensemble.name}</figcaption>
															</figure>
														) : (
															<span class="ensemble-chip">{ensemble.name}</span>
														)}
													</li>
												))}
											</ul>
										</div>
									)}
									<p class="event-card__admission">{entry.data.admission}</p>
									<div class="event-card__note">
										<Content />
									</div>
								</article>
							</li>
						))}
					</ol>
				) : (
					<p class="no-events">Noch keine vergangenen Auftritte.</p>
				)
			}
		</div>
	</section>
</Layout>

<style>
	.page-intro {
		padding-block: var(--space-2xl) var(--space-l);
	}

	.page-intro h1 {
		margin-top: var(--space-s);
	}

	.events-section {
		padding-block: var(--space-2xl);
		border-top: 1px solid var(--color-hairline);
	}

	.events-section h2 {
		margin-bottom: var(--space-l);
	}

	.no-events {
		color: var(--color-muted);
	}

	.event-list {
		display: flex;
		flex-direction: column;
		gap: var(--space-l);
	}

	.event-card {
		padding-block: var(--space-m);
		border-top: 1px solid var(--color-hairline);
	}

	.event-list > li:first-child .event-card {
		border-top: none;
		padding-top: 0;
	}

	.event-card__date {
		font-family: var(--font-sans);
		font-size: var(--step--1);
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.06em;
		color: var(--color-accent);
		margin-bottom: var(--space-2xs);
	}

	.event-card--past .event-card__date {
		color: var(--color-muted);
	}

	.event-card__title {
		margin-bottom: var(--space-2xs);
	}

	.event-card__venue {
		color: var(--color-ink);
		margin-bottom: var(--space-3xs);
	}

	.event-card__meta,
	.event-card__admission {
		color: var(--color-muted);
		font-size: var(--step--1);
		margin-bottom: var(--space-3xs);
	}

	.event-card__ensembles {
		margin-block: var(--space-s) var(--space-2xs);
	}

	.event-card__ensembles-label {
		display: block;
		margin-bottom: var(--space-2xs);
	}

	.ensemble-list {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-m);
	}

	.ensemble {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: var(--space-3xs);
	}

	.ensemble__logo {
		display: block;
		box-sizing: content-box;
		height: 40px;
		width: auto;
		max-width: 100%;
		/* JPEG logos aren't transparent; a white tile unifies their
		   differing backgrounds until transparent SVGs arrive. */
		background: #ffffff;
		padding: var(--space-2xs) var(--space-xs);
		border: 1px solid var(--color-hairline);
		border-radius: 6px;
	}

	.ensemble__name {
		font-size: var(--step--1);
		color: var(--color-muted);
	}

	.ensemble-chip {
		display: inline-flex;
		align-items: center;
		padding: var(--space-3xs) var(--space-xs);
		border: 1px solid var(--color-hairline);
		border-radius: 999px;
		font-size: var(--step--1);
		color: var(--color-ink);
	}

	.event-card__note {
		margin-top: var(--space-s);
		max-width: var(--measure);
	}

	.event-card__note :global(p) {
		color: var(--color-muted);
		font-size: var(--step--1);
	}
</style>
