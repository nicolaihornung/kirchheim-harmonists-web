---
import Layout from '../layouts/Layout.astro';
import Email from '../components/Email.astro';
---

<Layout title="Impressum" description="Impressum der Kirchheim Harmonists.">
	<section class="legal">
		<div class="container">
			<h1>Impressum</h1>

			<h2>Angaben gemäß § 5 DDG</h2>
			<p>
				Nicolai Hornung<br />
				Hauptstraße 45c<br />
				85551 Kirchheim bei München
			</p>

			<h2>Kontakt</h2>
			<!-- Optional: Telefonnummer kann bei Bedarf hier ergänzt werden. -->
			<p>
				E-Mail: <Email />
			</p>

			<h2>Inhaltlich verantwortlich gemäß § 18 Abs. 2 MStV</h2>
			<p>
				Nicolai Hornung<br />
				Anschrift wie oben
			</p>
		</div>
	</section>
</Layout>

<style>
	.legal {
		padding-block: var(--space-2xl);
	}

	.legal .container {
		max-width: var(--measure);
	}

	.legal h1 {
		margin-bottom: var(--space-l);
	}

	.legal h2 {
		font-size: var(--step-1);
		margin-top: var(--space-l);
		margin-bottom: var(--space-2xs);
	}
</style>
